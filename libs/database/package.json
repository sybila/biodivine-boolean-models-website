{
    "name": "@biodivine-boolean-models-website/database",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "check": "tsc --noEmit",
        "build": "tsc",
        "schema-generate": "prisma generate",
        "schema-migrate": "prisma migrate dev --name init",
        "database-reset": "prisma migrate reset",
        "database-seed": "prisma db seed",
        "database-recreate": "prisma migrate reset -f; prisma db seed",
        "studio": "prisma studio",
        "clean": "rm -r dist; rm tsconfig.tsbuildinfo"
    },
    "devDependencies": {
        "@types/node": "^25.0.6",
        "prisma": "^7.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "@prisma/language-server":"^31.3.4"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0"
    }
}

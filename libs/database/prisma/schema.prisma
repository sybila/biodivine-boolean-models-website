// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BooleanModel {
  id             Int      @id @default(autoincrement())
  name           String
  urlPublication String
  urlModel       String[]
  keywords       String[]
  variables      Int
  inputs         Int
  regulations    Int
  notes          String
  bib            String
  variableNames  String[]
  inputNames     String[]
  outputNames    String[]
}

model BooleanModelData {
  modelId        Int
  mimeType      String
  modelData Bytes

  @@id([modelId,mimeType])
}
